<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="500" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Авторизация" Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"/>

        <TextBlock Text="Логин:" FontSize="16" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Height="35"/>
        <TextBox x:Name="TbLogin" Grid.Row="1" Grid.Column="1" Margin="10" Height="35"/>

        <TextBlock Text="Пароль:" FontSize="16" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Height="35"/>
        <PasswordBox x:Name="PbPass" Grid.Row="2" Grid.Column="1" Margin="10" Height="35"/>

        <TextBlock Text="Капча:" FontSize="16" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,0,0"/>
        <UniformGrid x:Name="GridPanel" Grid.Row="3" Grid.Column="1" Rows="2" Columns="2" HorizontalAlignment="Left"/>

        <Button x:Name="BtnEnter" Content="Войти" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4" Grid.ColumnSpan="2" Width="125" Height="35" Click="BtnEnter_Click"/>
    </Grid>
</Window>