<Window x:Class="Demo.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdminWindow" Height="550" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Управление пользователем" Margin="5" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <Label Content="Логин:" Grid.Row="0"/>
                <TextBox x:Name="LogTB" Grid.Column="1" Grid.Row="0" Margin="2"/>
                <Label Content="Пароль:" Grid.Row="1"/>
                <TextBox x:Name="PassTB" Grid.Column="1" Grid.Row="1" Margin="2"/>
                <Label Content="Имя:" Grid.Row="2"/>
                <TextBox x:Name="NameTB" Grid.Column="1" Grid.Row="2" Margin="2"/>
                <Label Content="Фамилия:" Grid.Row="3"/>
                <TextBox x:Name="LastTB" Grid.Column="1" Grid.Row="3" Margin="2"/>
                <Label Content="Отчество:" Grid.Row="4"/>
                <TextBox x:Name="PatrTB" Grid.Column="1" Grid.Row="4" Margin="2"/>
                <Label Content="Роль:" Grid.Row="5"/>
                <ComboBox x:Name="RoleCB" Grid.Column="1" Grid.Row="5" Margin="2" DisplayMemberPath="naimenovaniye" SelectedValuePath="roli_id"/>

                <StackPanel Grid.Column="2" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Добавить" Width="100" Margin="5,0" Click="Add_Click"/>
                    <Button Content="Изменить" Width="100" Margin="5,0" Click="Edit_Click"/>
                    <Button Content="Разблокировать" Width="110" Margin="5,0" Click="Unblock_Click"/>
                    <Button Content="Очистить" Width="100" Margin="5,0" Click="Clear_Click"/>
                    <Button Content="Назад" Width="100" Margin="5,0" Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="GridUsers" Grid.Row="1" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridUsers_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding login_polzovatelya}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding imya}" Width="*"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding familiya}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding otchestvo}" Width="*"/>
                <DataGridCheckBoxColumn Header="Блок" Binding="{Binding zablokirovan}" Width="50"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Demo_Roli.naimenovaniye}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>